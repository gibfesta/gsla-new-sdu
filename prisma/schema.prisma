//
// HR Timesheets (Saturday → Saturday)
// NOTE: We store facility_id as a UUID string without a Prisma relation for now,
// because Facilities_Table does not have a simple primary key in the current schema.
//

enum TimesheetWeekStatus {
  DRAFT
  SUBMITTED
  RETURNED
  LOCKED
  SENT
}

enum TimesheetReasonCode {
  AS_ROTA
  ROTA_CHANGE
  OVERTIME
  SICK_COVER
  SICK_LEAVE
  ANNUAL_LEAVE
  UNPAID_LEAVE
  OTHER
}

model timesheet_week_packs {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  facility_id String              @db.Uuid
  week_start  DateTime            @db.Date
  week_end    DateTime            @db.Date
  status      TimesheetWeekStatus @default(DRAFT)

  submitted_by String?   @db.Uuid
  submitted_at DateTime? @db.Timestamptz(6)

  approved_by String?   @db.Uuid
  approved_at DateTime? @db.Timestamptz(6)

  locked_by String?   @db.Uuid
  locked_at DateTime? @db.Timestamptz(6)

  sent_to_treasury_by String?   @db.Uuid
  sent_to_treasury_at DateTime? @db.Timestamptz(6)

  created_at DateTime? @default(now()) @db.Timestamptz(6)
  updated_at DateTime? @default(now()) @db.Timestamptz(6)

  shifts timesheet_shift_entries[]
  audit  timesheet_audit_logs[]

  @@unique([facility_id, week_start])
  @@map("timesheet_week_packs")
}

model timesheet_shift_entries {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  week_pack_id String @db.Uuid

  date          DateTime @db.Date
  staff_user_id String?  @db.Uuid
  staff_label   String

  role_label String?

  planned_start String?
  planned_end   String?

  actual_start String
  actual_end   String

  reason TimesheetReasonCode @default(AS_ROTA)
  notes  String?

  created_at DateTime? @default(now()) @db.Timestamptz(6)
  updated_at DateTime? @default(now()) @db.Timestamptz(6)

  week_pack timesheet_week_packs @relation(fields: [week_pack_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([week_pack_id, date])
  @@map("timesheet_shift_entries")
}

model timesheet_audit_logs {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  week_pack_id String @db.Uuid

  actor_user_id String? @db.Uuid
  actor_label   String? @default("System")

  action String
  detail String?

  created_at DateTime? @default(now()) @db.Timestamptz(6)

  week_pack timesheet_week_packs @relation(fields: [week_pack_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([week_pack_id, created_at])
  @@map("timesheet_audit_logs")
}
