generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Facilities_Table {
  id            String   @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String   @default("required")
  type          String   @default("default:Other")
  status        String   @default("default:Operational")
  address       String   @default("default")
  contact_email String   @map("contact email")
  contact_phone String   @map("contact phone")
  notes         String
  created__at   DateTime @map("created _at") @db.Timestamp(6)
  updated_at    DateTime @db.Timestamp(6)

  @@id([id, name, type, status, address, contact_email, contact_phone, notes, created__at, updated_at])
  @@map("Facilities Table")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model activities {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String?   @db.Uuid
  title      String?
  date_text  String?
  time_text  String?
  location   String?
  kind       String?
  role_label String?
  status     String?
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  profiles   profiles? @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

